[Unit]
Description=Felo site previews (read-only, localhost; Tailscale Serve :8900)
After=network.target
[Service]
ExecStart=/usr/bin/python3 /usr/local/sbin/felo-site-preview
Restart=always
DynamicUser=no
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
