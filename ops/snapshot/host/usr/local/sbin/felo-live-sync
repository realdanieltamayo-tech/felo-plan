#!/usr/bin/env python3
"""Proxmox host, every minute: copy "what the AI team is doing now" from box 101 (felo-live-activity) into the
Felo app database (table felo_live) for the Factory page. Read-only on box 101."""
import json, subprocess, sys

def run(cmd, inp=None, timeout=40):
    return subprocess.run(cmd, input=inp, capture_output=True, text=True, timeout=timeout)

r = run(["pct", "exec", "101", "--", "/usr/local/sbin/felo-live-activity"])
if r.returncode != 0:
    sys.exit("box 101 activity could not be read")
data = json.loads(r.stdout)
body = json.dumps(data).replace("$lv$", "")
sql = ("CREATE TABLE IF NOT EXISTS felo_live(id int PRIMARY KEY CHECK(id=1), data jsonb NOT NULL, updated_at timestamptz NOT NULL DEFAULT now());\n"
       "INSERT INTO felo_live(id,data,updated_at) VALUES(1,$lv$" + body + "$lv$::jsonb,now()) ON CONFLICT(id) DO UPDATE SET data=EXCLUDED.data, updated_at=now();")
w = run(["pct", "exec", "100", "--", "docker", "exec", "-i", "felo-codex-preview-db", "sh", "-c",
         'psql -XqAt -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d felo_preview'], sql)
if w.returncode != 0:
    sys.exit("could not save to the Felo database")
print("live: %d active, %d jobs" % (len(data["active"]), len([j for j in data["jobs"] if j["status"] == "running"])))
