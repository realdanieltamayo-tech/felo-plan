#!/bin/bash
# Hand a new password/secret to Felo without it ever appearing on screen or in chat.
# Run on the Proxmox server (web UI -> Shell).  Usage:
#   felo-set-secret nextcloud      new Nextcloud app password for user daniel
#   felo-set-secret gmail-secret   new Google OAuth client secret (Gmail/Calendar app)
#   felo-set-secret anthropic      Anthropic API key for Hermes (starts with sk-ant-api)
#   felo-set-secret stripe         Stripe RESTRICTED read-only key (starts with rk_live_) for the Money page
# Claude then applies it, checks it works, and deletes the pending copy.
# Added 2026-09-24 for PRJ-01 1.1.
set -euo pipefail
case "${1:-}" in
  nextcloud)    label="new Nextcloud app password" ;;
  gmail-secret) label="new Google client secret" ;;
  anthropic)    label="Anthropic API key (starts with sk-ant-api)" ;;
  stripe)       label="Stripe restricted read-only key (starts with rk_live_)" ;;
  *) echo "Usage: felo-set-secret nextcloud | gmail-secret | anthropic | stripe"; exit 2 ;;
esac
read -rsp "Paste the $label, then press Enter (nothing will show): " v; echo
[ -n "$v" ] || { echo "Nothing entered. Nothing saved."; exit 1; }
[ "${#v}" -ge 16 ] || { echo "That looks too short (${#v} characters). Nothing saved."; exit 1; }
if [ "$1" = stripe ]; then
  # Read-only on purpose: only restricted keys, tested, and a write must be refused. Applied here, never shown.
  case "$v" in rk_live_*) ;; sk_*) echo "That is a FULL-ACCESS Stripe key. Felo must only get a restricted read-only key (rk_live_...). Nothing saved."; exit 1 ;;
    *) echo "That does not look like a Stripe restricted key (it should start with rk_live_). Nothing saved."; exit 1 ;; esac
  printf '%s' "$v" | pct exec 100 -- sh -c '
    umask 077; k=$(cat); set -e
    r=$(curl -s -o /dev/null -w "%{http_code}" -u "$k:" "https://api.stripe.com/v1/subscriptions?limit=1")
    [ "$r" = 200 ] || { echo "Stripe did not accept the key for reading subscriptions (HTTP $r). Check: Subscriptions = Read. Nothing saved."; exit 1; }
    w=$(curl -s -o /dev/null -w "%{http_code}" -u "$k:" -X POST "https://api.stripe.com/v1/products")
    [ "$w" = 403 ] || [ "$w" = 401 ] || { echo "This key can WRITE to Stripe (test answered HTTP $w). Make a key with only Read permissions. Nothing saved."; exit 1; }
    printf "STRIPE_READ_KEY=%s\n" "$k" > /root/felo-v2-runtime/stripe.env
    /root/felo-v2-runtime/apply-app-env.sh --from /root/felo-v2-runtime/stripe.env 2>&1 | tail -1'
  unset v
  echo "Stripe connected read-only. Tell Claude: \"stripe connected\"."
  exit 0
fi
if [ "$1" = anthropic ]; then
  case "$v" in sk-ant-api*) ;; *) echo "That does not look like an Anthropic API key (it should start with sk-ant-api). Nothing saved."; exit 1 ;; esac
  printf '%s' "$v" | pct exec 101 -- sh -c "umask 077; mkdir -p /root/.hermes/pending; cat > /root/.hermes/pending/anthropic"
else
  printf '%s' "$v" | pct exec 100 -- sh -c "umask 077; mkdir -p /root/felo-v2-runtime/pending; cat > /root/felo-v2-runtime/pending/$1"
fi
unset v
echo "Saved (${1}). Tell Claude: \"secret saved: $1\". It is used only after a check that it works."
