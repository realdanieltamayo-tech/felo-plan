#!/bin/sh
# Felo Studio release. Run on the PROXMOX HOST:  felo-studio-release
# 1) box 103 (Studio's own build box): refuse uncommitted work, build the app and web images, run the test suite (no network)
# 2) core loads both images and pushes them to the release store (core.tail0ff06a.ts.net:5443); git tag YYYY.MM.DD-n
# 3) core: start that exact version - felo-studio (API) and felo-studio-web (pages, :8098)
# felostudio.com is served by felo-studio-web alone; releases never touch the company site or its web server.
set -eu
BOX=103
REPO=/root/felo-studio
REG=core.tail0ff06a.ts.net:5443
pct exec $BOX -- sh -c "cd $REPO && git diff --quiet && git diff --cached --quiet" || { echo "Uncommitted changes on box $BOX. Commit first."; exit 1; }
DAY=$(date -u +%Y.%m.%d); N=1
while pct exec $BOX -- sh -c "cd $REPO && git rev-parse -q --verify refs/tags/$DAY-$N >/dev/null"; do N=$((N+1)); done
TAG=$DAY-$N
echo "== building felo-studio $TAG on box $BOX"
pct exec $BOX -- sh -c "cd $REPO && docker build -q -t felo-studio:$TAG . >/dev/null && docker build -q -f web/Dockerfile -t felo-studio-web:$TAG . >/dev/null"
echo "== tests"
pct exec $BOX -- sh -c "docker run --rm --network none -v $REPO:/w:ro -w /w -e PYTHONDONTWRITEBYTECODE=1 felo-studio:$TAG python -m tests.test_studio 2>&1 | tail -1" | tee /tmp/felo-studio-test.txt
grep -q "checks passed" /tmp/felo-studio-test.txt || { echo "Tests failed. Nothing released."; exit 1; }
pct exec $BOX -- sh -c "docker run --rm felo-studio-web:$TAG nginx -t 2>&1 | grep -q successful" || { echo "Web server config failed. Nothing released."; exit 1; }
pct exec $BOX -- sh -c "docker save felo-studio:$TAG felo-studio-web:$TAG | gzip -1 > /tmp/felo-studio-img.tgz && cd $REPO && tar -czf /tmp/felo-studio-site.tgz ops"
pct pull $BOX /tmp/felo-studio-img.tgz /tmp/felo-studio-img.tgz && pct pull $BOX /tmp/felo-studio-site.tgz /tmp/felo-studio-site.tgz
pct exec $BOX -- rm -f /tmp/felo-studio-img.tgz /tmp/felo-studio-site.tgz
scp -q /tmp/felo-studio-img.tgz /tmp/felo-studio-site.tgz core:/tmp/ && rm -f /tmp/felo-studio-img.tgz /tmp/felo-studio-site.tgz
ssh core "set -e
gunzip -c /tmp/felo-studio-img.tgz | docker load -q >/dev/null && rm /tmp/felo-studio-img.tgz
for I in felo-studio felo-studio-web; do docker tag \$I:$TAG $REG/\$I:$TAG && docker push -q $REG/\$I:$TAG >/dev/null && docker rmi \$I:$TAG >/dev/null; done"
pct exec $BOX -- sh -c "cd $REPO && git tag $TAG"
echo "== pushed $REG/felo-studio:$TAG and felo-studio-web:$TAG"
ssh core "set -e
rm -rf /tmp/felo-studio-rel && mkdir -p /tmp/felo-studio-rel && tar -xzf /tmp/felo-studio-site.tgz -C /tmp/felo-studio-rel && rm /tmp/felo-studio-site.tgz
mkdir -p /data/services/felo-studio /data/felo-studio && chown 1000:1000 /data/felo-studio
cp /tmp/felo-studio-rel/ops/docker-compose.yml /data/services/felo-studio/
cd /data/services/felo-studio && touch .env && chmod 600 .env
grep -q '^STUDIO_TAG=' .env && sed -i 's/^STUDIO_TAG=.*/STUDIO_TAG=$TAG/' .env || echo 'STUDIO_TAG=$TAG' >> .env
grep -q '^STUDIO_ADMIN_TOKEN=' .env || echo \"STUDIO_ADMIN_TOKEN=\$(python3 -c 'import secrets;print(secrets.token_urlsafe(32))')\" >> .env
STUDIO_TAG=$TAG docker compose pull -q && STUDIO_TAG=$TAG docker compose up -d --remove-orphans
sleep 3; curl -s localhost:8096/api/studio/health; echo
curl -s -o /dev/null -w 'studio web server: %{http_code}\n' localhost:8098/"
echo "== released felo-studio $TAG"
